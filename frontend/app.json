{
  "expo": {
    "name": "FluentStory",
    "slug": "fluentstory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fluentstory",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fluentstory.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Enable voice playback for stories",
        "NSMicrophoneUsageDescription": "Enable pronunciation practice"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF4500"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.fluentstory.app",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF4500"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF4500"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
