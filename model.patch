+# ============= FEEDBACK ENDPOINTS =============
+
+@api_router.post("/feedback/submit", response_model=FeedbackResponse)
+async def submit_feedback(user_id: str, feedback_data: FeedbackCreate):
+    """Submit user feedback"""
+    user = await db.users.find_one({"id": user_id})
+    if not user:
+        raise HTTPException(status_code=404, detail="User not found")
+    
+    # Create feedback record
+    feedback_id = str(uuid.uuid4())
+    feedback = {
+        "id": feedback_id,
+        "user_id": user_id,
+        "rating": feedback_data.rating,
+        "message": feedback_data.message,
+        "category": feedback_data.category,
+        "user_context": feedback_data.user_context,
+        "created_at": datetime.utcnow().isoformat()
+    }
+    
+    await db.feedback.insert_one(feedback)
+    
+    if '_id' in feedback:
+        del feedback['_id']
+    
+    return FeedbackResponse(**feedback)
+
+@api_router.get("/feedback/{user_id}", response_model=List[FeedbackResponse])
+async def get_user_feedback(user_id: str, limit: int = 50):
+    """Get all feedback from a user (admin use)"""
+    feedbacks = await db.feedback.find({"user_id": user_id}).sort("created_at", -1).limit(limit).to_list(limit)
+    
+    result = []
+    for feedback in feedbacks:
+        if '_id' in feedback:
+            del feedback['_id']
+        result.append(FeedbackResponse(**feedback))
+    
+    return result
+
